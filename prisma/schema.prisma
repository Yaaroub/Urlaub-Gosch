generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================================
// UNTERKÜNFTE
// ============================================================================

model Property {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String?
  location    String
  address     String?
  maxPersons  Int
  dogsAllowed Boolean @default(false)

  icalUrl       String?
  icalUpdatedAt DateTime?
  icalLastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lat    Float?
  lng    Float?
  region String?

  kuschelwochenEnabled Boolean @default(true)

  bookings         Booking[]
  requests         BookingRequest[]
  extras           ExtraCost[]
  favorites        Favorite[]
  lastMinuteOffers LastMinuteOffer[]
  pricePeriods     PricePeriod[]
  images           PropertyImage[]

  amenities Amenity[] @relation("AmenityToProperty")
}

// ============================================================================
// AUSSTATTUNG
// ============================================================================

model Amenity {
  id   Int    @id @default(autoincrement())
  name String @unique

  properties Property[] @relation("AmenityToProperty")
}

// ============================================================================
// PREISZEITEN
// ============================================================================

model PricePeriod {
  id            Int      @id @default(autoincrement())
  startDate     DateTime
  endDate       DateTime
  pricePerNight Decimal  @db.Decimal(10, 2)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

// ============================================================================
// BUCHUNGEN
// ============================================================================

model Booking {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  guestName String?

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId, startDate, endDate])
}

// ============================================================================
// NEBENKOSTEN
// ============================================================================

model ExtraCost {
  id    Int    @id @default(autoincrement())
  title String

  // Betrag in Cent
  amount Int

  // true = pro Nacht
  // false = einmalig
  isDaily Boolean @default(false)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ============================================================================
// BILDER
// ============================================================================

model PropertyImage {
  id   Int     @id @default(autoincrement())
  url  String
  alt  String?
  sort Int     @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ============================================================================
// BUCHUNGSANFRAGEN
// ============================================================================

model BookingRequest {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime

  guestName  String?
  guestEmail String?
  message    String?

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

// ============================================================================
// BENUTZERROLLEN
// ============================================================================

enum UserRole {
  USER
  EDITOR
  ADMIN
  SUPERADMIN
}

// ============================================================================
// ADMIN-BERECHTIGUNGEN
// ============================================================================

enum AdminPermission {
  // Objekte
  PROPERTIES_VIEW
  PROPERTIES_EDIT
  PROPERTIES_DELETE

  // Preiszeiten
  PRICES_VIEW
  PRICES_EDIT

  // Nebenkosten
  FEES_VIEW
  FEES_EDIT

  // Bilder
  IMAGES_VIEW
  IMAGES_EDIT
  IMAGES_DELETE

  // Verfügbarkeiten
  AVAILABILITY_VIEW
  AVAILABILITY_EDIT

  // iCal
  ICAL_VIEW
  ICAL_EDIT

  // Last-Minute
  LASTMINUTE_VIEW
  LASTMINUTE_EDIT
  LASTMINUTE_DELETE

  // Mitarbeiter
  STAFF_VIEW
  STAFF_CREATE
  STAFF_EDIT
  STAFF_LOCK
  STAFF_PASSWORD_RESET
  STAFF_PERMISSIONS_EDIT
  STAFF_DELETE
}

// ============================================================================
// BENUTZER
// ============================================================================

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String

  // Rolle
  role UserRole @default(USER)

  // Aktiv / gesperrt
  isActive Boolean @default(true)

  // Wird erhöht, um bestehende Sessions ungültig zu machen
  sessionVersion Int @default(0)

  // Automatische Abmeldung im Adminbereich
  sessionTimeoutMinutes Int @default(30)

  // Passwort muss beim nächsten Login geändert werden
  mustChangePassword Boolean @default(false)

  // Letzter erfolgreicher Login
  lastLoginAt DateTime?

  // Letzte Passwortänderung
  passwordChangedAt DateTime?

  favorites Favorite[]

  // Individuelle Adminrechte
  adminPermissions UserAdminPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// ============================================================================
// USER ↔ ADMIN-BERECHTIGUNG
// ============================================================================

model UserAdminPermission {
  id         Int             @id @default(autoincrement())
  userId     Int
  permission AdminPermission

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ============================================================================
// FAVORITEN
// ============================================================================

model Favorite {
  id Int @id @default(autoincrement())

  userId     Int
  propertyId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

// ============================================================================
// LAST-MINUTE
// ============================================================================

model LastMinuteOffer {
  id Int @id @default(autoincrement())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  discount       Int                    @default(0)
  discountAmount Decimal?               @db.Decimal(10, 2)
  discountType   LastMinuteDiscountType @default(PERCENT)

  note String?

  createdAt DateTime @default(now())

  @@index([propertyId, startDate, endDate])
}

// ============================================================================
// ENUMS
// ============================================================================

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum LastMinuteDiscountType {
  PERCENT
  FIXED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  NONE
  PAYPAL
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  NOT_REQUIRED
  REQUIRES_PAYMENT
  AUTHORIZED
  PAID
  REFUNDED
  CANCELED
}
