generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// *
///  * Unterkunft
model Property {
  id                   Int               @id @default(autoincrement())
  slug                 String            @unique
  title                String
  description          String?
  location             String
  address              String?
  maxPersons           Int
  dogsAllowed          Boolean           @default(false)
  icalUrl              String?
  icalUpdatedAt        DateTime?
  icalLastRunAt        DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lat                  Float?
  lng                  Float?
  region               String?
  kuschelwochenEnabled Boolean           @default(true)
  bookings             Booking[]
  requests             BookingRequest[]
  extras               ExtraCost[]
  favorites            Favorite[]
  lastMinuteOffers     LastMinuteOffer[]
  pricePeriods         PricePeriod[]
  images               PropertyImage[]
  amenities            Amenity[]         @relation("AmenityToProperty")
}

/// *
///  * Ausstattung (M:N)
model Amenity {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  properties Property[] @relation("AmenityToProperty")
}

/// *
///  * Preiszeiten
///  * Ende exklusiv
model PricePeriod {
  id            Int      @id @default(autoincrement())
  startDate     DateTime
  endDate       DateTime
  pricePerNight Decimal  @db.Decimal(10, 2)
  propertyId    Int
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

/// *
///  * Buchung
///  * Harte Belegung
model Booking {
  id         Int      @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  guestName  String?
  propertyId Int
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

/// *
///  * Nebenkosten
///  * amount in Cent
///  * isDaily = true
///  * => pro Nacht
///  * isDaily = false
///  * => einmalig pro Aufenthalt
model ExtraCost {
  id         Int      @id @default(autoincrement())
  title      String
  amount     Int
  isDaily    Boolean  @default(false)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// *
///  * Bilder der Unterkunft
model PropertyImage {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String?
  sort       Int      @default(0)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// *
///  * Unverbindliche Anfrage
model BookingRequest {
  id         Int           @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  guestName  String?
  guestEmail String?
  message    String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  propertyId Int
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

/// *
///  * Benutzer
///  * Wird sowohl für normale Kundenkonten
///  * als auch für Mitarbeiter/Admins verwendet.
enum UserRole {
  USER
  EDITOR
  ADMIN
  SUPERADMIN
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String

  // Benutzerrolle
  role UserRole @default(USER)

  // Konto aktiv / gesperrt
  isActive Boolean @default(true)

  // Sessions ungültig machen
  sessionVersion Int @default(0)

  // Letzter erfolgreicher Login
  lastLoginAt DateTime?

  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

/// *
///  * Favoriten
model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

/// *
///  * Last-Minute-Angebot
model LastMinuteOffer {
  id             Int                    @id @default(autoincrement())
  propertyId     Int
  startDate      DateTime
  endDate        DateTime
  discount       Int                    @default(0)
  note           String?
  createdAt      DateTime               @default(now())
  discountAmount Decimal?               @db.Decimal(10, 2)
  discountType   LastMinuteDiscountType @default(PERCENT)
  property       Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate, endDate])
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum LastMinuteDiscountType {
  PERCENT
  FIXED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  NONE
  PAYPAL
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  NOT_REQUIRED
  REQUIRES_PAYMENT
  AUTHORIZED
  PAID
  REFUNDED
  CANCELED
}
